# Site settings for the scripts in infrastructure/slurm.  Copy this file somewhere git does not track, fill it in, and
# point SITE_ENV at the copy.  It is sourced by bash on the laptop and copied to REMOTE_ROOT/site.env on the cluster,
# where job.sh exports every variable in it to the run.  Plain KEY=value lines; values without spaces unless quoted.

# Laptop side
SSH_HOST=cluster                                    # ssh alias of the login node in ~/.ssh/config (key login)
LOCAL_RESULTS=paper/phase-velocity-slices/data      # run folders are copied back here (repo-relative or absolute)
LOCAL_LOGS=paper/phase-velocity-slices/data/slurm_logs   # Slurm logs and the ledger are copied back here

# Cluster side (absolute paths, no spaces)
REMOTE_ROOT=/path/on/the/cluster/krmhd-p1           # run code (REMOTE_ROOT/repo), environment (REMOTE_ROOT/venv),
                                                    # Slurm logs (REMOTE_ROOT/logs) and the ledger
REMOTE_RESULTS=/path/on/the/cluster/scratch/krmhd-p1/results   # run folders (the driver's --base)
MODULES=""                                          # modules to load before Python, e.g. "python/3.11"; empty: none
PYTHON=python3.11                                   # interpreter for the environment (3.11 or newer), or uv:3.11
                                                    # for a Python that uv downloads (where python3 is older)
JAX_CUDA=cuda12                                     # cuda12 (NVIDIA driver >= 525) or cuda13 (driver >= 580)
SBATCH_OPTS="--gres=gpu:1 --cpus-per-task=8 --mem=64G"   # partition, account, QOS, GPU type: always one GPU
JOB_TIME=24:00:00                                   # Slurm time limit per job, HH:MM:SS or D-HH:MM:SS
JAX_PLATFORMS=cuda                                  # the run code uses the CPU unless this is set
REQUIRE_GPU=1                                       # job.sh stops at once if JAX sees no GPU
# XLA_PYTHON_CLIENT_MEM_FRACTION=0.95               # JAX takes 75% of the GPU memory by default; a 256^3 run needs
                                                    # about 81 GiB, so raise this on a GPU with less than ~110 GB
