# Study 04 loop settings. Read by run_iteration.sh (sourced) and by modal_launch.py.
# Only Anjor edits this file. A loop commit that touches loop/ makes the runner write STOP.
# Plain KEY=VALUE lines only: no command substitution, no quotes needed.

# Compute cap for the whole study, in A100-hours. modal_launch.py refuses any launch that
# would take hours used + hours reserved + the new reservation above this number.
COMPUTE_CAP_A100_HOURS=200

# The headless Claude Code session.
CLAUDE_BIN=~/.local/bin/claude
CLAUDE_MODEL=opus
CLAUDE_EFFORT=high
# Empty means no --max-budget-usd flag.
MAX_BUDGET_USD=

# Iteration limits.
DAILY_ITERATION_CAP=10
TOTAL_ITERATION_CAP=400
WIP_STREAK_LIMIT=6

# Timing, in seconds. The runner kills a session at SESSION_TIME_LIMIT_SEC.
SESSION_TIME_LIMIT_SEC=7200
PAUSE_BETWEEN_ITERATIONS_SEC=300
# A session that fails within FAST_FAIL_SEC (auth error, rate limit) makes the runner wait
# FAST_FAIL_BACKOFF_SEC before the next attempt.
FAST_FAIL_SEC=120
FAST_FAIL_BACKOFF_SEC=3600
WATCHDOG_POLL_SEC=2
KILL_GRACE_SEC=15

# Where the loop changes GANDALF. Never ../gandalf.
GANDALF_WORKTREE=~/repos/anjor/gandalf-study04

# Modal. The launcher names every app MODAL_APP_PREFIX-<launch>-<set>; the runner writes
# STOP if a running app with this prefix is not in compute_ledger.json.
MODAL_APP_PREFIX=s04-loop
MODAL_VOLUME=krmhd-benchmark-vol
MODAL_VOLUME_ROOT=study04
# 1: after each session, write STOP for ANY Modal app created during the session that the
# ledger does not know, whatever its name. This catches GPU spend outside the launcher, but
# it also stops the loop if Anjor starts his own Modal app while a session runs (he then
# resumes it). 0: check only apps whose name starts with MODAL_APP_PREFIX, as the brief asks.
STOP_ON_ANY_NEW_MODAL_APP=1

# When a session reports that a Claude usage limit was hit (rate_limit_event with status
# rejected), the runner waits until the reported reset time plus this margin.
RATE_LIMIT_MARGIN_SEC=300

# Git identity for every loop commit, so loop commits and Anjor's commits can be told apart.
LOOP_GIT_NAME=krmhd-loop
LOOP_GIT_EMAIL=anjor@umd.edu
