#!/bin/bash
# Stub of the modal CLI. Used only by loop/selftest.sh (and preflight tests); never by the loop.
#
#   modal app list --json     prints $S04_STUB_DIR/apps.json, or [] if absent
#   modal volume list --json  prints a list that contains krmhd-benchmark-vol
#   anything else             prints nothing, exits 0
# If $S04_STUB_DIR/modal_fail exists every call fails, as when not logged in. Every call is
# appended to $S04_STUB_DIR/modal_calls, so a test can check what the runner asked for.

set -u
D="${S04_STUB_DIR:-}"
if [ -n "$D" ]; then
  mkdir -p "$D"
  echo "$*" >> "$D/modal_calls"
  if [ -f "$D/modal_fail" ]; then
    echo "Token missing. Run 'modal setup' (stub)." >&2
    exit 1
  fi
fi
case "${1:-} ${2:-}" in
  "app list")
    if [ -n "$D" ] && [ -f "$D/apps.json" ]; then cat "$D/apps.json"; else echo "[]"; fi
    ;;
  "volume list")
    echo '[{"Name": "krmhd-benchmark-vol", "Created at": "2026-03-26 10:00:00+00:00"}]'
    ;;
  "--version "*)
    echo "modal client version: 1.3.5 (stub)"
    ;;
esac
exit 0
